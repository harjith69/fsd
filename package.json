{
  "name": "faculty-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Faculty Performance & Academic Activity Dashboard (MERN)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "start": "npm run start --workspace=server",
    "seed": "npm run seed --workspace=server",
    "build": "npm run build --workspace=client",
    "install:all": "npm install && npm install --workspace=server && npm install --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
